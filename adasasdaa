--// This script uses the external Consistt/Ui library to create a graphical user interface.
--// It includes examples of a watermark, notifications, a main window with a tab, and
--// various components like toggles, buttons, text boxes, and sliders.

--// Load the UI library from the provided URL.
local library = loadstring(game:HttpGet("https://raw.githubusercontent.com/Consistt/Ui/main/UnLeaked"))()

--// Set the user's rank for the watermark.
library.rank = "OWNER"

--// Create a watermark at the top of the screen.
--// It displays a title, version, username, and rank.
local Wm = library:Watermark("ORBIT  -  HUB | v" .. library.version .. " | " .. library:GetUsername() .. " | rank: " .. library.rank)

--// Add a sub-watermark to display the FPS.
local FpsWm = Wm:AddWatermark("fps: " .. library.fps)

--// Use a coroutine to update the FPS watermark every 0.75 seconds.
coroutine.wrap(function()
    while wait(.75) do
        FpsWm:Text("fps: " .. library.fps)
    end
end)()

--// Initialize the notification system.
local Notif = library:InitNotifications()

--// Show a loading notification when the script starts.
local LoadingXSX = Notif:Notify("Loading ORBIT - HUB, please be patient.", 5, "information")

--// Set the main title for the UI window.
library.title = "ORBIT  -  HUB"

--// Display the introduction animation for the library.
library:Introduction()
wait(1)

--// Initialize the main UI window.
local Init = library:Init()

--// Create a new tab named "Example tab" inside the main window.
local Tab1 = Init:NewTab("Example tab")

--// Create a section within the tab for organizing components.
local Section1 = Tab1:NewSection("Example Components")

--// Add a simple text label.
local Label1 = Tab1:NewLabel("Example label", "left")

--// Create a toggle with a keybind (RightControl) to turn it on/off.
--// The function passed to NewToggle will run whenever the toggle's state changes.
local Toggle1 = Tab1:NewToggle("Example toggle", false, function(value)
    local vers = value and "on" or "off"
    print("one " .. vers)
end):AddKeybind(Enum.KeyCode.RightControl)

--// Create another toggle with a different keybind (LeftControl).
local Toggle2 = Tab1:NewToggle("Toggle", false, function(value)
    local vers = value and "on" or "off"
    print("two " .. vers)
end):AddKeybind(Enum.KeyCode.LeftControl)

--// Add a button that prints "one" when clicked.
local Button1 = Tab1:NewButton("Button", function()
    print("one")
end)

--// Create a keybind component that lets the user change the keybind.
local Keybind1 = Tab1:NewKeybind("Keybind 1", Enum.KeyCode.RightAlt, function(key)
    Init:UpdateKeybind(Enum.KeyCode[key])
end)

--// Add three text boxes with different sizes.
local Textbox1 = Tab1:NewTextbox("Text box 1 [auto scales // small]", "", "1", "all", "small", true, false, function(val)
    print(val)
end)

local Textbox2 = Tab1:NewTextbox("Text box 2 [medium]", "", "2", "all", "medium", true, false, function(val)
    print(val)
end)

local Textbox3 = Tab1:NewTextbox("Text box 3 [large]", "", "3", "all", "large", true, false, function(val)
    print(val)
end)

--// Add a selector component with predefined options.
local Selector1 = Tab1:NewSelector("Selector 1", "bungie", {"fg", "fge", "fg", "fg"}, function(d)
    print(d)
end):AddOption("fge")

--// Add a slider component with a minimum, maximum, and default value.
local Slider1 = Tab1:NewSlider("Slider 1", "", true, "/", {min = 1, max = 100, default = 20}, function(value)
    print(value)
end)

--// Show a success notification when the UI is fully loaded.
local FinishedLoading = Notif:Notify("Loaded ORBUT  -   HUB", 4, "success")
